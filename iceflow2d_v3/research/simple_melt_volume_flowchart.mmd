flowchart TD
    A(["开始：固定冰块完全融化试验"]) --> B["记录融化前水量 V0、冰质量 m0 和冰占据区域"]
    B --> C["执行热相变与几何刷新<br/>计算实际融冰质量 Δm"]
    C --> D["计算目标水量<br/>Vt = V0 + Δm / (ρw · dx²)"]
    D --> E["在真正融尽的原冰区域设置候选水：φ = 1"]
    E --> F["识别与融水相连的水域<br/>水下：相连水池；空气中：新水滴"]
    F --> G["统计当前水量 V = Σφ<br/>计算残差 R = Vt - V"]
    G --> H{"残差绝对值 ≤ 容差？"}
    H -- 是 --> N["修正 f32 舍入残差<br/>同步分布函数并重新恢复宏观量"]
    N --> O{"水量误差和相场范围检查通过？"}
    O -- 是 --> P(["结束：得到满足目标水量的相场"])
    O -- 否 --> X
    H -- 否 --> I["在所选水域寻找当前水气界面带 B<br/>R < 0：C = Σφ<br/>R > 0：C = Σ(1 - φ)"]
    I --> J{"C > 0 且未超过迭代上限？"}
    J -- 否 --> X(["报告修正失败"])
    J -- 是 --> K["计算有界修正比例<br/>a = min(1, 残差绝对值 / C)"]
    K --> L["R < 0：φ ← (1 - a)φ<br/>R > 0：φ ← φ + a(1 - φ)"]
    L --> M["更新界面位置<br/>一层容量用尽时，下一轮处理下一层"]
    M --> G
